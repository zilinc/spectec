def $popvalue(val*) : (val, val*)
def $popvalue(val val'*) = (val, val'*)

def $pushvalue(val, val*) : val*
def $pushvalue(val, val'*) = val val'*

def $popvalues(val*) : (val*, val*)
def $popvalues(val* val'*) = (val*, val'*)

def $pushvalues(val*, val*) : val*
def $pushvalues(val*, val'*) = val* val'*


def $runinstr(instr, val*) : instr*
def $runinstr(instr, val*) = val* instr

def $updatez(state, def $updater(state) : state) : state
def $updatez(z, $f) = $f(z)


rule Step/pure  hint(no_prose)
rule Step/read  hint(no_prose)
rule Step/call_ref-hostfunc-res  hint(no_prose)
rule Step/call_ref-hostfunc-div  hint(no_prose)

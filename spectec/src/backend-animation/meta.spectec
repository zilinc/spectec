;; ********************************************************
;;             Algorithmic value validation
;; ********************************************************

def $ref_infer(store, ref) : reftype
def $ref_infer(s, REF.NULL_ADDR) = REF NULL BOT
def $ref_infer(s, REF.I31_NUM i) = REF I31
def $ref_infer(s, REF.STRUCT_ADDR a) = REF dt
  -- if s.STRUCTS[a].TYPE = dt
def $ref_infer(s, REF.ARRAY_ADDR a) = REF dt
  -- if s.ARRAYS[a].TYPE = dt
def $ref_infer(s, REF.FUNC_ADDR a) = REF dt
  -- if s.FUNCS[a].TYPE = dt
def $ref_infer(s, REF.EXN_ADDR a) = REF EXN
  -- if s.EXNS[a] = exn
def $ref_infer(s, REF.HOST_ADDR a) = REF ANY
def $ref_infer(s, REF.EXTERN ref) = REF EXTERN
  -- Ref_ok: s |- ref : REF ANY
  -- if ref =/= REF.NULL_ADDR

def $val_infer(store, val) : valtype
def $val_infer(s, num) = nt
  -- Num_ok: s |- num : nt
def $val_infer(s, vec) = vt
  -- Vec_ok: s |- vec : vt
def $val_infer(s, ref) = rt
  -- if $ref_infer(s, ref) = rt

def $top_of_heaptype(deftype*, heaptype) : heaptype
def $top_of_heaptype(dt*, ht) = ANY
  -- if ht <- ANY NONE EQ STRUCT ARRAY I31
def $top_of_heaptype(dt*, ht) = FUNC
  -- if ht <- FUNC NOFUNC
def $top_of_heaptype(dt*, ht) = EXN
  -- if ht <- EXN NOEXN
def $top_of_heaptype(dt*, ht) = EXTERN
  -- if ht <- EXTERN NOEXTERN
def $top_of_heaptype(dt*, typeuse) = $top_of_typeuse(dt*, typeuse)

def $top_of_typeuse(deftype*, typeuse) : heaptype
def $top_of_typeuse(dt*, _IDX x) = $top_of_comptype(dt*, $expanddt(dt*[x]))
def $top_of_typeuse(dt*, dt') = $top_of_comptype(dt*, $expanddt(dt'))

def $top_of_comptype(deftype*, comptype) : heaptype
def $top_of_comptype(dt*, STRUCT ft*) = $top_of_heaptype(dt*, STRUCT)
def $top_of_comptype(dt*, ARRAY ft) = $top_of_heaptype(dt*, STRUCT)
def $top_of_comptype(dt*, FUNC t_1* -> t_2*) = $top_of_heaptype(dt*, FUNC)


rule Heaptype_sub/trans-any:
  C |- ht <: ANY
  -- if ht <- STRUCT ARRAY I31

rule Heaptype_sub/struct-trans:
  C |- deftype <: ht
  -- Expand: deftype ~~ STRUCT fieldtype*
  -- if ht <- ANY EQ

rule Heaptype_sub/array-trans:
  C |- deftype <: ht
  -- Expand: deftype ~~ ARRAY fieldtype
  -- if ht <- ANY EQ


rule Comptype_sub/struct_alg:
  C |- STRUCT ft'_1* <: STRUCT ft_2*
  -- if len = |ft_2*|
  -- if ft_1* = ft'_1*[0:len]
  -- (Fieldtype_sub: C |- ft_1 <: ft_2)*


def $reftype_sub(context, reftype, reftype) : bool
def $reftype_sub       hint(builtin)

def $heaptype_sub(context, heaptype, heaptype) : bool
def $heaptype_sub      hint(builtin)

def $ref_ok(store, ref, reftype) : bool
def $ref_ok            hint(builtin)

def $externaddr_ok(store, externaddr, externtype) : bool
def $externaddr_ok     hint(builtin)

def $check_list(syntax X, syntax Y, context, def $check(context, X) : (context, Y), X*) : (context, Y*)
def $check_list(syntax X, syntax Y, C, $check, eps) = (C, eps)
def $check_list(syntax X, syntax Y, C, $check, u u'*) = (C'', v v'*)
  -- if $check(C, u) = (C', v)
  -- if $check_list(syntax X, syntax Y, C', $check, u'*) = (C'', v'*)

syntax unit = `()

def $check_type_ok(context, type) : (context, unit)
def $check_type_ok(C, TYPE rectype) = (C ++ {TYPES dt*}, `())
  -- if x = |C.TYPES|
  -- if dt* = $rolldt(x, rectype)

def $check_import_ok(context, import) : (context, unit)
def $check_import_ok(C, IMPORT name_1 name_2 xt) = ((C ++ {TAGS jt}), `())
  -- if $clos_externtype(C, xt) = TAG jt
def $check_import_ok(C, IMPORT name_1 name_2 xt) = ((C ++ {GLOBALS gt}), `())
  -- if $clos_externtype(C, xt) = GLOBAL gt
def $check_import_ok(C, IMPORT name_1 name_2 xt) = ((C ++ {MEMS mt}), `())
  -- if $clos_externtype(C, xt) = MEM mt
def $check_import_ok(C, IMPORT name_1 name_2 xt) = ((C ++ {TABLES tt}), `())
  -- if $clos_externtype(C, xt) = TABLE tt
def $check_import_ok(C, IMPORT name_1 name_2 xt) = ((C ++ {FUNCS dt}), `())
  -- if $clos_externtype(C, xt) = FUNC ut
  -- if $as_deftype(ut) = dt

def $check_tag_ok(context, tag) : (context, unit)
def $check_tag_ok(C, TAG tagtype) = (C ++ {TAGS jt}, `())
  -- if $clos_tagtype(C, tagtype) = jt

def $check_func_ok(context, func) : (context, unit)
def $check_func_ok(C, FUNC x local* expr) = (C ++ {FUNCS (C.TYPES[x])}, `())

def $check_mem_ok(context, mem) : (context, unit)
def $check_mem_ok(C, MEMORY mt) = (C ++ {MEMS mt}, `())

def $check_table_ok(context, table) : (context, unit)
def $check_table_ok(C, TABLE tt expr) = (C ++ {TABLES tt}, `())

def $check_global_ok(context, global) : (context, unit)
def $check_global_ok(C, GLOBAL gt expr) = (C ++ {GLOBALS gt}, `())

def $check_data_ok(context, data) : (context, unit)
def $check_data_ok(C, DATA b* datamode) = (C ++ {DATAS OK}, `())

def $check_elem_ok(context, elem) : (context, unit)
def $check_elem_ok(C, ELEM et expr* elemmode) = (C ++ {ELEMS et}, `())

def $module_prepass(module) : context
def $module_prepass(module) = C_9
  -- if MODULE type* import* tag* global* mem* table* func* data* elem* start? export* = module
  -- if x* = $funcidx_nonfuncs(global* mem* table* elem* start? export*)
  -- if C_0 = {REFS x*}
  -- if (C_1, u_1*) = $check_list(type  , unit, C_0, $check_type_ok  , type*  )
  -- if (C_2, u_2*) = $check_list(import, unit, C_1, $check_import_ok, import*)
  -- if (C_3, u_3*) = $check_list(tag   , unit, C_2, $check_tag_ok   , tag*   )
  -- if (C_4, u_4*) = $check_list(func  , unit, C_3, $check_func_ok  , func*  )
  -- if (C_5, u_5*) = $check_list(mem   , unit, C_4, $check_mem_ok   , mem*   )
  -- if (C_6, u_6*) = $check_list(table , unit, C_5, $check_table_ok , table* )
  -- if (C_7, u_7*) = $check_list(global, unit, C_6, $check_global_ok, global*)
  -- if (C_8, u_8*) = $check_list(data  , unit, C_7, $check_data_ok  , data*  )
  -- if (C_9, u_9*) = $check_list(elem  , unit, C_8, $check_elem_ok  , elem*  )

;; Assumes that we have run a pre-pass to figure out C.
;; An argument C is added to the relation; the body is exactly the same as Module_ok.
relation Module_ok_alg: context |- module : moduletype
rule Module_ok_alg:
  C |- MODULE type* import* tag* global* mem* table* func* data* elem* start? export* : $clos_moduletype(C, xt_I* -> xt_E*)
  -- Types_ok: {} |- type* : dt'*
  -- (Import_ok: {TYPES dt'*} |- import : xt_I)*
  ----
  -- (Tag_ok: C' |- tag : jt)*
  -- Globals_ok: C' |- global* : gt*
  -- (Mem_ok: C' |- mem : mt)*
  -- (Table_ok: C' |- table : tt)*
  -- (Func_ok: C |- func : dt)*
  ----
  -- (Data_ok: C |- data : ok)*
  -- (Elem_ok: C |- elem : rt)*
  -- (Start_ok: C |- start : OK)?
  -- (Export_ok: C |- export : nm xt_E)*
  -- if $disjoint_(name, nm*)
  ----
  -- if C = C' ++ {TAGS jt_I* jt*, GLOBALS gt*, MEMS mt_I* mt*, TABLES tt_I* tt*, DATAS ok*, ELEMS rt*}
  ----
  -- if C' = {TYPES dt'*, GLOBALS gt_I*, FUNCS dt_I* dt*, REFS x*}
  -- if x* = $funcidx_nonfuncs(global* mem* table* elem* start? export*)
  ----
  -- if jt_I* = $tagsxt(xt_I*)
  -- if gt_I* = $globalsxt(xt_I*)
  -- if mt_I* = $memsxt(xt_I*)
  -- if tt_I* = $tablesxt(xt_I*)
  -- if dt_I* = $funcsxt(xt_I*)

def $module_ok(module) : moduletype
def $module_ok(module) = moduletype
  -- if C = $module_prepass(module)
  -- Module_ok_alg: C |- module : moduletype

syntax ellipses = `...
syntax inferresulttype = ellipses? `| resulttype
syntax inferinstrtype = inferresulttype ->_(localidx*) inferresulttype

relation Stack_sub: context |- resulttype <: resulttype
rule Stack_sub:
  C |- t_1* <: t_2*
  -- (Resulttype_sub: C |- t_1 <: t_2)*

def $push(context, inferresulttype, inferresulttype) : inferresulttype
def $push(C, `| t_1*, ell? `| t_2*) = ell? `| t_2* t_1*
def $push(C, `| t_1*, `| eps) = `| t_1*
def $push(C, ell_1? `| t_1*, ell_2? `| eps) = (`... `| t_1*)
  -- otherwise

def $pop(context, inferresulttype, inferresulttype) : inferresulttype
def $pop(C, `... `| t_1*, `... `| t_2*) = `... `| eps
  -- if n_1 = |t_1*|
  -- if n_2 = |t_2*|
  -- if n = $min(n_1, n_2)
  -- if n_3 = $(n_1 - n)
  -- if t_21^(n_2 - n) t_22* = t_2*
  -- Stack_sub: C |- BOT^n_3 t_22* <: t_1*
def $pop(C, `| t_1*, `... `| t_2*) = `... `| t_21^(n_2 - n)
  -- if n_1 = |t_1*|
  -- if n_2 = |t_2*|
  -- if n = $min(n_1, n_2)
  -- if n_3 = $(n_1 - n)
  -- if t_21^(n_2 - n) t_22* = t_2*
  -- Stack_sub: C |- BOT^n_3 t_22* <: t_1*
def $pop(C, `... `| t_1*, `| t_2*) = `| eps
  -- if n_1 = |t_1*|
  -- if n_2 = |t_2*|
  -- if n = $min(n_1, n_2)
  -- if t_21^(n_2 - n) t_22* = t_2*
  -- Stack_sub: C |- t_22* <: t_1*
def $pop(C, `| t_1*, `| t_2*) = `| t_21^(n_2 - n)
  -- if n_1 = |t_1*|
  -- if n_2 = |t_2*|
  -- if n = $min(n_1, n_2)
  -- if t_21^(n_2 - n) t_22* = t_2*
  -- Stack_sub: C |- t_22* <: t_1*

def $peek(nat, inferresulttype) : valtype
;; def $peek(i, ell? `| t*) = t'
;;   -- if t_1'* = t_1* ++ t'
;;   -- if t* = t_1'* ++ t_2^i
def $peek(i, ell? `| t*) = t*[j:1][0]
  -- if n = |t*|
  -- if j = $(n - i - 1) >= 0  ;; -- var j : int
def $peek(i, ell? `| t*) = BOT
  -- otherwise

def $peek_ref(nat, inferresulttype) : reftype
def $peek_ref(i, stack) = rt
  -- if $peek(i, stack) = rt
def $peek_ref(i, stack) = REF BOT
  -- if $peek(i, stack) = BOT

def $expr_ok(context, expr, resulttype) : bool
def $expr_ok(C, instr*, t*) = $check_block(C, instr*, eps -> t*)

def $check_block(context, expr, instrtype) : bool
def $check_block(C, instr*, t_1* ->_(x*) t_2*) = true
  -- if $check_instrs(C, instr*, `| t_1*) = (stack, x'*)
  -- if $pop(C, `| t_2*, stack) = ell? `| eps
def $check_block(C, instr*, t_1* ->_(x*) t_2*) = false
  -- otherwise

def $check_instrs(context, instr*, inferresulttype) : (inferresulttype, localidx*)
def $check_instrs(C, eps, stack) = (stack, eps)
def $check_instrs(C, instr instr'*, stack) = $check_instrs(C', instr'*, stack')
  -- if stack_1 ->_(x_1*) stack_2 = $check_instr(C, instr, stack)
  -- (if C.LOCALS[x_1] = init t)*
  -- if C' = $with_locals(C, x_1*, (SET t)*)
  -- if stack' = $push(C, stack_2, $pop(C, stack_1, stack))

def $check_instr(context, instr, inferresulttype) : inferinstrtype
def $check_instr(C, instr, stack) = `| t_1* ->_(x*) `| t_2*
  -- Instr_ok: C |- instr : t_1* ->_(x*) t_2*
def $check_instr(C, instr, stack) = ist
  -- Instr_ok_alg: C |- instr : ist -| stack


relation Instr_ok_alg: context |- instr : inferinstrtype -| inferresulttype

rule Instr_ok_alg/unreachable:
  C |- UNREACHABLE : (`... `| eps) -> (`... `| eps) -| stack

rule Instr_ok_alg/drop:
  C |- DROP : `| $peek(0, stack) -> `| eps -| stack

rule Instr_ok_alg/select-impl:
  C |- SELECT : `| t t I32 -> `| t -| stack
  -- if t = $peek(1, stack)
  ;; -- if t <- numtype vectyp BOT
  -- if t = numtype \/ t = vectype \/ t = BOT

rule Instr_ok_alg/block:
  C |- BLOCK bt instr* : `| t_1* -> `| t_2* -| stack
  -- Blocktype_ok: C |- bt : t_1* -> t_2*
  -- Instrs_ok: {LABELS (t_2*)} ++ C |- instr* : t_1* -> t_2*

rule Instr_ok_alg/loop:
  C |- LOOP bt instr* : `| t_1* -> `| t_2* -| stack
  -- Blocktype_ok: C |- bt : t_1* -> t_2*
  -- Instrs_ok: {LABELS (t_1*)} ++ C |- instr* : t_1* -> t_2*

rule Instr_ok_alg/if:
  C |- IF bt instr_1* ELSE instr_2* : `| t_1* I32 -> `| t_2* -| stack
  -- Blocktype_ok: C |- bt : t_1* -> t_2*
  -- Instrs_ok: {LABELS (t_2*)} ++ C |- instr_1* : t_1* -> t_2*
  -- Instrs_ok: {LABELS (t_2*)} ++ C |- instr_2* : t_1* -> t_2*

rule Instr_ok_alg/br:
  C |- BR l : `... `| t* -> `... `| eps -| stack
  -- if C.LABELS[l] = t*

rule Instr_ok_alg/br_table:
  C |- BR_TABLE l* l' : `... `| t^n I32 -> `... `| eps -| stack
  -- if t'* = C.LABELS[l']
  -- if n = |t'*|
  -- (if t = $peek($(n-i), stack))^(i<n)
  -- Stack_sub: C |- t^n <: t'*
  -- (Stack_sub: C |- t^n <: C.LABELS[l])*

rule Instr_ok_alg/br_on_null:
  C |- BR_ON_NULL l : `| t* (REF NULL ht) -> `| t* (REF ht) -| stack
  -- if REF nul? ht = $peek_ref(0, stack)
  -- if C.LABELS[l] = t*
  -- Heaptype_ok: C |- ht : OK

rule Instr_ok_alg/return:
  C |- RETURN : `... `| t* -> `... `| eps -| stack
  -- if C.RETURN = (t*)

rule Instr_ok_alg/return_call:
  C |- RETURN_CALL x : `... `| t_1* -> `... `| eps -| stack
  -- Expand: C.FUNCS[x] ~~ FUNC t_1* -> t_2*
  -- if C.RETURN = (t'_2*)
  -- Resulttype_sub: C |- t_2* <: t'_2*

rule Instr_ok_alg/return_call_ref:
  C |- RETURN_CALL_REF (_IDX x) : `... `| t_1* (REF NULL (_IDX x)) -> `... `| eps -| stack
  -- Expand: C.TYPES[x] ~~ FUNC t_1* -> t_2*
  -- if C.RETURN = (t'_2*)
  -- Resulttype_sub: C |- t_2* <: t'_2*

rule Instr_ok_alg/return_call_indirect:
  C |- RETURN_CALL_INDIRECT x (_IDX y) : `... `| t_1* at -> `... `| eps -| stack
  -- if C.TABLES[x] = at lim rt
  -- Reftype_sub: C |- rt <: (REF NULL FUNC)
  ----
  -- Expand: C.TYPES[y] ~~ FUNC t_1* -> t_2*
  -- if C.RETURN = (t'_2*)
  -- Resulttype_sub: C |- t_2* <: t'_2*

rule Instr_ok_alg/throw:
  C |- THROW x : `... `| t* -> `... `| eps -| stack
  -- Expand: $as_deftype(C.TAGS[x]) ~~ FUNC t* -> eps  ;; eps or t'*?

rule Instr_ok_alg/throw_ref:
  C |- THROW_REF : `... `| (REF NULL EXN) -> `... `| eps -| stack

rule Instr_ok_alg/try_table:
  C |- TRY_TABLE bt catch* instr* : `| t_1* -> `| t_2* -| stack
  -- Blocktype_ok: C |- bt : t_1* -> t_2*
  -- Instrs_ok: {LABELS (t_2*)} ++ C |- instr* : t_1* -> t_2*
  -- (Catch_ok: C |- catch : OK)*
  ;; Blocktype_ok doesn't produce x*, which should be used in the return type as well.

rule Instr_ok_alg/ref.is_null:
  C |- REF.IS_NULL : `| (REF NULL ht) -> `| I32 -| stack
  -- if $peek_ref(0, stack) = REF nul? ht
  ;; -- Heaptype_ok: C |- ht : OK

rule Instr_ok_alg/ref.as_non_null:
  C |- REF.AS_NON_NULL : `| (REF NULL ht) -> `| (REF ht) -| stack
  -- if $peek_ref(0, stack) = REF nul? ht
  -- Heaptype_ok: C |- ht : OK

rule Instr_ok_alg/ref.test:
  C |- REF.TEST rt : `| (REF NULL ht') -> `| I32 -| stack
  -- if REF nul? ht = rt
  -- Reftype_ok: C |- rt : OK
  -- if ht' = $top_of_heaptype(C.TYPES, ht)

rule Instr_ok_alg/ref.cast:
  C |- REF.CAST rt : `| (REF NULL ht') -> `| (REF nul? ht) -| stack
  -- if REF nul? ht = rt
  -- Reftype_ok: C |- rt : OK
  -- if ht' = $top_of_heaptype(C.TYPES, ht)

rule Instr_ok_alg/extern.convert_any:
  C |- EXTERN.CONVERT_ANY : `| (REF nul? ANY) -> `| (REF nul? EXTERN) -| stack
  -- if REF nul? ht = $peek_ref(0, stack)

rule Instr_ok_alg/any.convert_extern:
  C |- ANY.CONVERT_EXTERN : `| (REF nul? EXTERN) -> `| (REF nul? ANY) -| stack
  -- if REF nul? ht = $peek_ref(0, stack)



;; ********************************************************
;;                      Reduction
;; ********************************************************


syntax stackcount = nat


def $is_val(instr) : bool
def $is_val(val) = true
def $is_val(instr) = false  -- otherwise

def $find_first_instr'(instr*, instr*) : (instr*, instr?, instr*)
def $find_first_instr'(val*, []) = (val*, eps, eps)
def $find_first_instr'(val*, instr instr'*) = (val*, instr, instr'*)
  -- if $is_val(instr) = false
def $find_first_instr'(val*, instr instr'*) = (val_1*, instr_1?, instr'_1*)
  -- if $is_val(instr) = true
  ;; -- otherwise
  -- if $find_first_instr'(val* instr, instr'*) = (val_1*, instr_1?, instr'_1*)

def $find_first_instr(instr*) : (instr*, instr?, instr*)
def $find_first_instr(instr*) = $find_first_instr'(eps, instr*)
  ;; -- if instr* =/= eps

def $use_step(instr)      : bool
def $use_step_pure(instr) : bool
def $use_step_read(instr) : bool
def $use_step_ctxt(instr) : bool

def $use_step               hint(builtin)
def $use_step_pure          hint(builtin)
def $use_step_read          hint(builtin)
def $use_step_ctxt          hint(builtin)


syntax stepresult = STEP config | STUCK | STACK_OVERFLOW


;; According to the `instr`, call the right $Step_.../... function
def $dispatch_step(instr, config)      : config
def $dispatch_step_pure(instr, instr*) : instr*
def $dispatch_step_read(instr, config) : instr*
def $dispatch_step_label(nat, val*, instr?, state, instr*, bool) : config
def $dispatch_step_frame(nat, val*, instr?, state, bool) : config
def $dispatch_step_handler(nat, val*, instr?, state, catch*, bool) : config

def $step_ctxt(config, stackcount) : stepresult

def $dispatch_step                hint(builtin)
def $dispatch_step_pure           hint(builtin)
def $dispatch_step_read           hint(builtin)


;; The input `config` consists of the whole value stack, plus the first instruction.
def $dispatch_reduce(state, val*, instr, stackcount) : stepresult
def $dispatch_reduce(z, val*, instr_0, stackcount) = STEP (z; instr_1*)
  -- if $use_step_pure(instr_0) = true
  -- if $dispatch_step_pure(instr_0, val* instr_0) = instr_1*
def $dispatch_reduce(z, val*, instr_0, stackcount) = STEP (z; instr_1*)
  -- if $use_step_read(instr_0) = true
  -- if $dispatch_step_read(instr_0, (z; val* instr_0)) = instr_1*
def $dispatch_reduce(z, val*, instr_0, stackcount) = STEP config_1
  -- if $use_step(instr_0) = true
  -- if $dispatch_step(instr_0, (z; val* instr_0)) = config_1
def $dispatch_reduce(z, val*, instr_0, stackcount) = STEP (z'; val* instr_1*)
  -- if $use_step_ctxt(instr_0) = true
  -- if $step_ctxt((z; instr_0), stackcount) = STEP (z'; instr_1*)
def $dispatch_reduce(z, val*, instr_0, stackcount) = STACK_OVERFLOW
  -- if $step_ctxt((z; instr_0), stackcount) = STACK_OVERFLOW
def $dispatch_reduce(z, val*, instr_0, stackcount) = STUCK
  -- otherwise


def $Step_read_throw_ref_handler(config) : instr*
def $Step_read_throw_ref_handler           hint(builtin)

def $reduce(config, stackcount) : stepresult
def $step(config, stackcount) : config
;; A non-reflexive version of the transitive closure of single step reduction.
def $steps_pg(config, stackcount) : config?
def $steps(config, stackcount) : config


def $step_ctxt((z; LABEL_ n `{instr_1*} instr*), stackcount) = STEP config
  -- if $find_first_instr(instr*) = (val*, instr_0?, instr'*)
  -- if bl = (instr'* = eps)
  -- if $dispatch_step_label(n, val*, instr_0?, z, instr_1*, bl) = config
def $step_ctxt((z; LABEL_ n `{instr_1*} instr*), stackcount) = STEP (z'; (LABEL_ n `{instr_1*} instr'*))
  -- if $steps_pg((z; instr*), stackcount) = z'; instr'*
def $step_ctxt((z; FRAME_ n `{f'} instr*), stackcount) = STEP config
  -- if $find_first_instr(instr*) = (val*, instr_0?, instr'*)
  -- if bl = (instr'* = eps)
  -- if $dispatch_step_frame(n, val*, instr_0?, z, bl) = config
def $step_ctxt((s; f; FRAME_ n `{f'} instr*), stackcount) = STEP (s'; f; (FRAME_ n `{f''} instr'*))
  -- if stackcount > 0
  -- if $steps_pg((s; f'; instr*), $(stackcount-1)) = s'; f''; instr'*
def $step_ctxt((s; f; FRAME_ n `{f'} instr*), stackcount) = STACK_OVERFLOW
  -- if stackcount <= 0
def $step_ctxt((z; HANDLER_ n `{catch*} instr*), stackcount) = STEP config
  -- if $find_first_instr(instr*) = (val*, instr_0?, instr'*)
  -- if bl = (instr'* = eps)
  -- if $dispatch_step_handler(n, val*, instr_0?, z, catch*, bl) = config
def $step_ctxt((z; HANDLER_ n `{catch*} instr*), stackcount) = STEP (z'; (HANDLER_ n `{catch*} instr'*))
  -- if $steps_pg((z; instr*), stackcount) = z'; instr'*


def $dispatch_step_label(n, val*, BR l, z, instr*, bl) = z; val''^n instr*
  -- if val'* val''^n = val*
  -- if l = 0
def $dispatch_step_label(n, val*, BR l, z, instr*, bl) = z; val* (BR $(l - 1))
  -- if l > 0
def $dispatch_step_label(n, val*, RETURN_CALL_REF yy, z, instr*, bl) = z; val* (RETURN_CALL_REF yy)
def $dispatch_step_label(n, val*, RETURN, z, instr*, bl) = z; val* RETURN
def $dispatch_step_label(n, REF.EXN_ADDR a, THROW_REF, z, instr*, true) = z; (REF.EXN_ADDR a) THROW_REF
def $dispatch_step_label(n, eps, TRAP, z, instr*, true) = z; TRAP
def $dispatch_step_label(n, val*, eps, z, instr*, true) = z; val*

def $dispatch_step_frame(n, val* REF.NULL_ADDR, RETURN_CALL_REF yy, z, bl) = z; TRAP
def $dispatch_step_frame(k, val* (REF.FUNC_ADDR a), RETURN_CALL_REF yy, z, bl) = z; val''^n (REF.FUNC_ADDR a) (CALL_REF yy)
  -- if val'* val''^n = val*
  -- Expand: $funcinst(z)[a].TYPE ~~ FUNC t_1^n -> t_2^m
def $dispatch_step_frame(n, val*, RETURN, z, bl) = z; val''^n
  -- if val'* val''^n = val*
def $dispatch_step_frame(n, REF.EXN_ADDR a, THROW_REF, z, true) = z; (REF.EXN_ADDR a) THROW_REF
def $dispatch_step_frame(n, eps, TRAP, z, true) = z; TRAP
def $dispatch_step_frame(n, val^n, eps, z, true) = z; val^n

def $dispatch_step_handler(n, val*, BR l, z, catch*, bl) = z; val* (BR l)
def $dispatch_step_handler(n, val*, RETURN_CALL_REF yy, z, catch*, bl) = z; val* (RETURN_CALL_REF yy)
def $dispatch_step_handler(n, val*, RETURN, z, catch*, bl) = z; val* RETURN
def $dispatch_step_handler(n, REF.EXN_ADDR a, THROW_REF, z, catch*, true) = z; instr'*
  -- if $Step_read_throw_ref_handler(z; (HANDLER_ n `{catch*} (REF.EXN_ADDR a) THROW_REF)) = instr'*
def $dispatch_step_handler(n, eps, TRAP, z, catch*, true) = z; TRAP
def $dispatch_step_handler(n, val*, eps, z, catch*, true) = z; val*



def $reduce((s; f; instr+), stackcount) = STEP (s; f; TRAP)
  -- if $find_first_instr(instr+) = (val*, TRAP, instr_1'*)
  -- if val* =/= eps \/ instr_1'* =/= eps
def $reduce((s; f; instr+), stackcount) = STEP (s; f; (REF.EXN_ADDR a) THROW_REF)
  -- if $find_first_instr(instr+) = (val* (REF.EXN_ADDR a), THROW_REF, instr_1'*)
  -- if val* =/= eps \/ instr_1'* =/= eps
def $reduce((z; instr+), stackcount) = STEP (z'; instr_2* instr_1'*)
  -- if $find_first_instr(instr+) = (val*, instr_1, instr_1'*)
  -- if $dispatch_reduce(z, val*, instr_1, stackcount) = STEP (z'; instr_2*)
def $reduce((z; instr+), stackcount) = STACK_OVERFLOW
  -- if $find_first_instr(instr+) = (val*, instr_1, instr_1'*)
  -- if $dispatch_reduce(z, val*, instr_1, stackcount) = STACK_OVERFLOW
def $reduce((s; f; instr*), stackcount) = STUCK
  -- otherwise


def $step(config, stackcount) = config'
  -- if $reduce(config, stackcount) = STEP config'


def $steps_pg(config, stackcount) = config_2
  -- if $step(config, stackcount) = config_1
  -- if $steps(config_1, stackcount) = config_2
def $steps_pg(config, stackcount) = eps
  -- otherwise

def $steps(config, stackcount) = config_2
  -- if $step(config, stackcount) = config_1
  -- if $steps(config_1, stackcount) = config_2
def $steps(config, stackcount) = config
  -- otherwise



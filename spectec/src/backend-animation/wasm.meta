def $splitstack(instr*) : (val*, instr)
def $splitstack(val* instr) = ($rev_(syntax val, val*), instr)

def $pop(val*) : (val, val*)
def $pop(val val'*) = (val, val'*)

def $push(val, val*) : val*
def $push(val, val'*) = val val'*

def $runinstr(val*, instr) : instr*
def $runinstr(val*, instr) = $rev_(syntax val, val*) instr

def $updatez(state, def $updater(state) : state) : state
def $updatez(z, $f) = $f(z)

;;
;; Tests for $min, $sum, $prod (0.2) — return 1 for pass, 0 for fail
;;

def $test_min_basic() : nat
def $test_min_basic() = 1  -- if $($min(3, 5) = 3)
def $test_min_basic() = 0  -- otherwise

def $test_min_equal() : nat
def $test_min_equal() = 1  -- if $($min(7, 7) = 7)
def $test_min_equal() = 0  -- otherwise

def $test_sum_empty() : nat
def $test_sum_empty() = 1  -- if $($sum(eps) = 0)
def $test_sum_empty() = 0  -- otherwise

def $test_sum_simple() : nat
def $test_sum_simple() = 1  -- if $($sum(1 2 3 eps) = 6)
def $test_sum_simple() = 0  -- otherwise

def $test_prod_empty() : nat
def $test_prod_empty() = 1  -- if $($prod(eps) = 1)
def $test_prod_empty() = 0  -- otherwise

def $test_prod_simple() : nat
def $test_prod_simple() = 1  -- if $($prod(2 3 4 eps) = 24)
def $test_prod_simple() = 0  -- otherwise

;; Aggregate: product of all test results (1 means all pass, 0 if any fail)
def $run_tests2() : nat
def $run_tests2() = $prod(
  $test_min_basic()
  $test_min_equal()
  $test_sum_empty()
  $test_sum_simple()
  $test_prod_empty()
  $test_prod_simple()
  eps
)

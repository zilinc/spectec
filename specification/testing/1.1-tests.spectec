;;
;; Minimal tests for values / ints / floats / indices / free-sets
;;

;; --- floating-point basics ---
def $test_fzero32() : nat
def $test_fzero32() = 1  -- if $fzero(32) = POS (SUBNORM 0)
def $test_fzero32() = 0

def $test_fone64() : nat
def $test_fone64() = 1  -- if $fone(64) = POS (NORM 1 0)
def $test_fone64() = 0

def $test_fnat32() : nat
def $test_fnat32() = 1  -- if $fnat(32, 7) = POS (NORM 7 0)
def $test_fnat32() = 0

def $test_canon32() : nat
def $test_canon32() = 1  -- if $canon_(32) = 4194304
def $test_canon32() = 0


;; --- externidx projections ---
def $test_funcsxx_basic() : nat
def $test_funcsxx_basic() = 1
  -- if $funcsxx( ((FUNC 5) (GLOBAL 7) (FUNC 9)) ) = (5 9)
def $test_funcsxx_basic() = 0

def $test_funcsxx_empty() : nat
def $test_funcsxx_empty() = 1  -- if $funcsxx(eps) = eps
def $test_funcsxx_empty() = 0

def $test_tablesxx_basic() : nat
def $test_tablesxx_basic() = 1
  -- if $tablesxx( ((TABLE 5) (TABLE 7) (FUNC 9)) ) = (5 7)
def $test_tablesxx_basic() = 0

def $test_memsxx_basic() : nat
def $test_memsxx_basic() = 1
  -- if $memsxx( ((MEM 5) (GLOBAL 7) (FUNC 9)) ) = (5)
def $test_memsxx_basic() = 0

def $test_tagsxx_basic() : nat
def $test_tagsxx_basic() = 1
  -- if $tagsxx( ((FUNC 5) (GLOBAL 7) (TAG 9)) ) = (9)
def $test_tagsxx_basic() = 0


;; --- free_* helpers ---
def $test_free_opt_empty() : nat
def $test_free_opt_empty() = 1  -- if $free_opt(eps) = {}
def $test_free_opt_empty() = 0

def $test_free_extern_func() : nat
def $test_free_extern_func() = 1  -- if $free_externidx(FUNC 3) = {FUNCS 3}
def $test_free_extern_func() = 0

def $test_free_extern_global() : nat
def $test_free_extern_global() = 1  -- if $free_externidx(GLOBAL 1) = {GLOBALS 1}
def $test_free_extern_global() = 0

def $test_free_tableidx() : nat
def $test_free_tableidx() = 1  -- if $free_tableidx(1) = {TABLES (1)}
def $test_free_tableidx() = 0

def $test_free_list_combine() : nat
def $test_free_list_combine() = 1
  -- if $free_list( ({FUNCS 1, MEMS 7} {GLOBALS (2 2)}) ) = {FUNCS (1), GLOBALS (2 2), MEMS 7}
def $test_free_list_combine() = 0

def $test_free_list_triple() : nat
def $test_free_list_triple() = 1
  -- if $free_list( ({TYPES (4 5), DATAS (8)} {TYPES (6), MEMS (9 9)} {MEMS (1 2 3)}) )
       = {TYPES (4 5 6), MEMS (9 9 1 2 3), DATAS (8)}
def $test_free_list_triple() = 0


def $run_tests4() : nat
def $run_tests4() =
  $prod(
    $test_fzero32()
    $test_fone64()
    $test_fnat32()
    $test_canon32()
    $test_funcsxx_basic()
    $test_funcsxx_empty()
    $test_tablesxx_basic()
    $test_memsxx_basic()
    $test_tagsxx_basic()
    $test_free_opt_empty()
    $test_free_extern_func()
    $test_free_extern_global()
    $test_free_tableidx()
    $test_free_list_combine()
    eps
  )
